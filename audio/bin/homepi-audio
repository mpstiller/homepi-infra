#!/usr/bin/python3
"""TrueHD -> AC3 pilot/worker. Default is a read-only plan, never apply."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time
import urllib.request
import urllib.error
from urllib.parse import quote
import uuid

ROOTS = (Path('/srv/data/media/movies'), Path('/srv/data/media/tv'))
ARCHIVE = Path('/srv/data/media-originals')
STAGING = Path('/srv/data/.homepi-audio-staging')
STATE = Path('/srv/appdata/homepi-audio/state.json')
KEY = Path('/etc/homepi-audio/jellyfin.key')
LOCK = Path('/run/lock/homepi-restic.lock')


def log(message):
    print(message, flush=True)


def fingerprint(path):
    s = path.lstat()
    if not stat.S_ISREG(s.st_mode):
        raise ValueError('not a regular file')
    return [s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns]


def checked_source(path, roots=ROOTS):
    path = Path(os.path.abspath(path))
    if ':' in str(path) or path.suffix.lower() != '.mkv':
        raise ValueError('only MKV paths without colon are supported')
    for root in roots:
        if path.is_relative_to(root) and path != root:
            if any(p.is_symlink() for p in (path, *path.parents)):
                raise ValueError('symlink path rejected')
            fingerprint(path)
            return path
    raise ValueError('file is outside the movies/tv libraries')


def ffmpeg_args(info):
    args = ['-map', '0', '-c', 'copy', '-map_metadata', '0', '-map_chapters', '0']
    audio = [s for s in info['streams'] if s['codec_type'] == 'audio']
    count = 0
    for i, stream in enumerate(audio):
        if stream['codec_name'] != 'truehd':
            continue
        channels = stream.get('channels', 0)
        if channels not in (1, 2, 6, 8):
            raise ValueError('unsupported TrueHD channel count')
        # 7.1 -> 5.1 only in the derived TV file. Full original is archived.
        target = min(channels, 6)
        title = stream.get('tags', {}).get('title', '').strip()
        title = (title + ' | ' if title else '') + 'AC3 TV-compatible'
        args += [f'-c:a:{i}', 'ac3', f'-b:a:{i}', '192k' if target <= 2 else '640k',
                 f'-ac:a:{i}', str(target), f'-threads:a:{i}', '1',
                 f'-metadata:s:a:{i}', 'title=' + title]
        count += 1
    return args, count


class DockerMedia:
    def __init__(self):
        self.image = subprocess.run(
            ['docker', 'inspect', '-f', '{{.Image}}', 'jellyfin'],
            check=True, capture_output=True, text=True).stdout.strip()
        if not self.image.startswith('sha256:'):
            raise ValueError('cannot identify running Jellyfin image')

    def run(self, source, tool, args, output=None):
        name = 'homepi-audio-' + uuid.uuid4().hex[:12]
        s = source.stat()
        cmd = ['docker', 'run', '--rm', '--pull', 'never', '--name', name,
               '--network', 'none', '--read-only', '--cap-drop', 'ALL',
               '--security-opt', 'no-new-privileges', '--cpus', '1',
               '--memory', '512m', '--memory-swap', '512m', '--pids-limit', '128',
               '--user', f'{s.st_uid}:{s.st_gid}', '-v', f'{source}:/input.mkv:ro']
        if output:
            cmd += ['-v', f'{output}:/output']
        cmd += ['--entrypoint', '/usr/lib/jellyfin-ffmpeg/' + tool, self.image, *args]
        try:
            return subprocess.run(cmd, check=True, capture_output=True,
                                  text=True, timeout=7200).stdout
        finally:
            # Also handles SIGTERM/timeout: an orphan converter must not linger.
            subprocess.run(['docker', 'rm', '-f', name], stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=30)

    def probe(self, source):
        return json.loads(self.run(source, 'ffprobe', [
            '-v', 'error', '-show_streams', '-show_format', '-show_chapters',
            '-of', 'json', '/input.mkv']))

    def video_hash(self, source, ordinal):
        return self.run(source, 'ffmpeg', ['-v', 'error', '-nostdin',
            '-i', '/input.mkv', '-map', f'0:v:{ordinal}', '-c', 'copy',
            '-f', 'hash', '-hash', 'sha256', '-']).strip()

    def convert(self, source, folder, info):
        args, count = ffmpeg_args(info)
        if not count:
            raise ValueError('no TrueHD to convert')
        self.run(source, 'ffmpeg', ['-v', 'error', '-nostdin', '-n',
                 '-i', '/input.mkv', *args, '/output/result.mkv'], folder)


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


class Jellyfin:
    def __init__(self, keyfile=KEY):
        s = keyfile.stat()
        if s.st_uid != 0 or stat.S_IMODE(s.st_mode) & 0o077 or keyfile.is_symlink():
            raise ValueError('Jellyfin key must be root-owned and private')
        self.key = keyfile.read_text().strip()
        if not self.key:
            raise ValueError('Jellyfin key is empty')
        self.opener = urllib.request.build_opener(
            urllib.request.ProxyHandler({}), NoRedirect)

    def request(self, path, method='GET'):
        request = urllib.request.Request('http://127.0.0.1:8096' + path,
            headers={'Authorization': 'MediaBrowser Token="' + quote(self.key, safe='') + '"'}, method=method,
            data=b'' if method == 'POST' else None)
        try:
            with self.opener.open(request, timeout=10) as response:
                return response.read()
        except urllib.error.HTTPError as error:
            raise ValueError(f'Jellyfin API HTTP {error.code}: {method} {path}') from None
        except Exception as error:
            raise ValueError(f'Jellyfin API connection failed ({type(error).__name__}): {method} {path}') from None

    def idle(self):
        sessions = json.loads(self.request('/Sessions'))
        if not isinstance(sessions, list) or any(not isinstance(s, dict) for s in sessions):
            raise ValueError('unrecognized session response')
        # Conservative: paused sessions and music also defer replacement.
        return not any(s.get('NowPlayingItem') for s in sessions)

    def refresh(self):
        self.request('/Library/Refresh', 'POST')


def verify(before, after, media, source, result):
    old, new = before['streams'], after['streams']
    if len(old) != len(new):
        raise ValueError('stream count changed')
    for a, b in zip(old, new):
        if a['codec_type'] != b['codec_type']:
            raise ValueError('stream type/order changed')
        expected = 'ac3' if a['codec_name'] == 'truehd' else a['codec_name']
        if b['codec_name'] != expected:
            raise ValueError('unexpected codec change')
        if a['codec_type'] == 'audio':
            expected_channels = min(a['channels'], 6) if a['codec_name'] == 'truehd' else a['channels']
            if b['channels'] != expected_channels:
                raise ValueError('unexpected channel count')
        for tag in ('language',):
            if a.get('tags', {}).get(tag) != b.get('tags', {}).get(tag):
                raise ValueError('stream language changed')
        if a['codec_type'] == 'video':
            for key in ('width', 'height', 'pix_fmt'):
                if a.get(key) != b.get(key):
                    raise ValueError('video properties changed')
    if len(before.get('chapters', [])) != len(after.get('chapters', [])):
        raise ValueError('chapter count changed')
    if abs(float(before['format']['duration']) - float(after['format']['duration'])) > 1:
        raise ValueError('duration changed by more than one second')
    for i in range(sum(s['codec_type'] == 'video' for s in old)):
        digest = media.video_hash(source, i)
        if not digest.startswith('SHA256=') or digest != media.video_hash(result, i):
            raise ValueError('encoded video payload hash differs')


def archive_and_replace(source, result, expected, archive=ARCHIVE, *, keep_original=False):
    if fingerprint(source) != expected:
        raise ValueError('source changed; replacement refused')
    s = source.stat()
    os.chown(result, s.st_uid, s.st_gid)
    os.chmod(result, stat.S_IMODE(s.st_mode))
    with result.open('rb') as f:
        os.fsync(f.fileno())
    entry = None
    if keep_original:
        archive.mkdir(parents=True, exist_ok=True, mode=0o700)
        if archive.is_symlink() or s.st_dev != archive.stat().st_dev:
            raise ValueError('archive must be a real directory on the same filesystem')
        entry = archive / (time.strftime('%Y%m%dT%H%M%S') + '-' + uuid.uuid4().hex[:12])
        entry.mkdir(mode=0o700)
        record = {'source': str(source), 'fingerprint': expected,
                  'original': 'original.mkv', 'status': 'prepared'}
        manifest = entry / 'manifest.json'
        manifest.write_text(json.dumps(record, indent=2) + '\n')
        with manifest.open('rb') as f:
            os.fsync(f.fileno())
        os.link(source, entry / 'original.mkv', follow_symlinks=False)
        if fingerprint(entry / 'original.mkv') != expected:
            raise ValueError('source changed during archiving; replacement refused')
        for folder in (entry, archive):
            fd = os.open(folder, os.O_RDONLY | os.O_DIRECTORY)
            try:
                os.fsync(fd)
            finally:
                os.close(fd)
    # Never write into a shared inode. Existing torrent links retain old bytes.
    if fingerprint(source) != expected:
        raise ValueError('source changed before commit; replacement refused')
    os.replace(result, source)
    fd = os.open(source.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)
    if entry:
        # A prepared manifest remains a recovery record after power loss.
        record['status'] = 'replaced'
        manifest.write_text(json.dumps(record, indent=2) + '\n')
    return entry


def process(source, media, jellyfin, *, keep_original=False):
    expected = fingerprint(source)
    if not jellyfin.idle():
        log('DEFER: Jellyfin has a playing/paused session')
        return False
    if shutil.disk_usage(source.parent).free < expected[2] * 1.5 + 2 * 1024**3:
        raise ValueError('insufficient space for output plus 2 GiB reserve')
    info = media.probe(source)
    _, count = ffmpeg_args(info)
    if not count:
        return False
    STAGING.mkdir(parents=True, exist_ok=True, mode=0o700)
    if STAGING.is_symlink() or STAGING.stat().st_dev != source.stat().st_dev:
        raise ValueError('staging must be a real directory on the same filesystem')
    folder = Path(tempfile.mkdtemp(prefix='job-', dir=STAGING))
    s = source.stat()
    os.chown(folder, s.st_uid, s.st_gid)
    try:
        media.convert(source, folder, info)
        result = folder / 'result.mkv'
        verify(info, media.probe(result), media, source, result)
        if not jellyfin.idle():
            log('DEFER: playback started during conversion; original untouched')
            return False
        entry = archive_and_replace(source, result, expected, keep_original=keep_original)
        log(f'REPLACED: {source}; original archive: {entry if entry else "disabled"}')
        jellyfin.refresh()
        return True
    finally:
        shutil.rmtree(folder)


def candidates(roots=ROOTS):
    for root in roots:
        if not root.is_dir() or root.is_symlink():
            raise ValueError('media root missing or symlinked')
        for folder, dirs, names in os.walk(root, followlinks=False):
            dirs[:] = sorted(d for d in dirs if not d.startswith('.')
                             and not (Path(folder) / d).is_symlink())
            for name in sorted(names):
                path = Path(folder) / name
                if path.suffix.lower() == '.mkv' and not path.is_symlink():
                    yield checked_source(path, roots)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument('--file', type=Path)
    group.add_argument('--scan', action='store_true')
    parser.add_argument('--apply', action='store_true')
    parser.add_argument('--keep-original', action='store_true',
                        help='retain the complete original for the single-file pilot')
    args = parser.parse_args()
    if args.keep_original and not args.file:
        parser.error('--keep-original is limited to an explicit --file pilot')
    os.umask(0o077)
    # Nonblocking common lock: never overlap backup or another audio worker.
    with LOCK.open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            log('DEFER: backup/maintenance/audio lock is busy')
            return
        media = DockerMedia()
        jellyfin = Jellyfin() if args.apply else None
        if jellyfin and not jellyfin.idle():
            log('DEFER: Jellyfin has a playing/paused session')
            return
        state = json.loads(STATE.read_text()) if STATE.exists() else {}
        paths = [checked_source(args.file)] if args.file else candidates()
        for source in paths:
            signature = fingerprint(source)
            if time.time() - source.stat().st_mtime < 300:
                log(f'DEFER: file younger than five minutes: {source}')
                continue
            if args.scan and state.get(str(source)) == signature:
                continue
            info = media.probe(source)
            _, count = ffmpeg_args(info)
            if count:
                retention = 'retained (pilot)' if args.keep_original else 'not archived'
                log(f'PLAN: {source}; {count} TrueHD track(s) -> AC3; original {retention}')
                if args.apply:
                    process(source, media, jellyfin, keep_original=args.keep_original)
                    break  # At most one candidate conversion per invocation.
            elif args.apply:
                state[str(source)] = signature
        if args.apply:
            STATE.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            with tempfile.NamedTemporaryFile('w', dir=STATE.parent, delete=False) as f:
                json.dump(state, f)
                temp = f.name
            os.replace(temp, STATE)


if __name__ == '__main__':
    def interrupted(signum, frame):
        raise InterruptedError('audio worker interrupted')
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGINT, interrupted)
    try:
        main()
    except Exception as error:
        # API headers and raw subprocess stderr are intentionally not logged.
        log('FAILED: ' + (str(error) if isinstance(error, ValueError) else type(error).__name__))
        sys.exit(1)
