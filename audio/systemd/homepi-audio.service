[Unit]
Description=HomePi TrueHD audio compatibility worker
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/homepi-audio/enabled

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/homepi-audio --scan --apply
TimeoutStartSec=0
TimeoutStopSec=90
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
