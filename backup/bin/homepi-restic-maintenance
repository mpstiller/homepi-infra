#!/usr/bin/env bash
set -Eeuo pipefail

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 077

# Serialize staging, upload, retention and maintenance, including manual runs.
command -v flock >/dev/null
exec 9>/run/lock/homepi-restic.lock
echo "Waiting for the HomePi backup/maintenance lock..."
flock -x 9

export HOME=/root
export XDG_CACHE_HOME=/var/cache/homepi-backup

RESTIC_REPOSITORY="rclone:gdrive:HomePi-Backup"
RESTIC_PASSWORD_FILE="/etc/restic/homepi-password"
RCLONE_CONFIG="/etc/rclone/homepi.conf"

echo "=== HomePi restic maintenance started: $(date --iso-8601=seconds) ==="

echo "Pruning unreferenced repository data..."

restic \
  -o rclone.args="serve restic --stdio --config=${RCLONE_CONFIG}" \
  -r "$RESTIC_REPOSITORY" \
  --password-file "$RESTIC_PASSWORD_FILE" \
  prune

echo "Checking repository integrity..."

restic \
  -o rclone.args="serve restic --stdio --config=${RCLONE_CONFIG}" \
  -r "$RESTIC_REPOSITORY" \
  --password-file "$RESTIC_PASSWORD_FILE" \
  check

echo "=== HomePi restic maintenance completed: $(date --iso-8601=seconds) ==="
