# Copy to .env on HomePi; NEVER commit .env. Generate both secrets locally.
# Confirm using: id -u; id -g
PAPERLESS_UID=1000
PAPERLESS_GID=1000
PAPERLESS_PORT=8010

# On the Pi, generate private values separately with:
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_VALUE
PAPERLESS_SECRET_KEY=REPLACE_WITH_DIFFERENT_GENERATED_VALUE
